# Optional: copy this file to api/.env. Never commit credentials.
# Neon's repository-root .env.local is also loaded automatically.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# MCP defaults allow localhost and Render's service hostname automatically.
# An explicit list replaces those defaults; use hostnames without schemes/ports.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],api.example.com
DB_STORAGE=./data/events.sqlite
# Production: set the hosted PostgreSQL URL in Render's Environment settings.
# DATABASE_URL takes precedence over DB_STORAGE. Keep the real URL secret.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set SMTP_URL and a provider-approved MAIL_FROM to deliver confirmations.
# Without SMTP_URL, jobs remain pending in the database.
# Render Free blocks ports 25, 465, and 587; choose an endpoint the host permits.
# SMTP_URL=smtps://USER:PASSWORD@HOST:465
# MAIL_FROM=Campus Events <events@example.com>
MAIL_POLL_INTERVAL_SECONDS=5
MAIL_RETRY_BASE_SECONDS=30
MAIL_RETRY_MAX_SECONDS=3600
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
